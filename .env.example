# Copy to .env for local runs (never commit .env). On GitHub, add these as
# repository secrets instead (Settings → Secrets and variables → Actions).

# Claude API key (https://platform.claude.com/). Without it the app runs in
# keyword-only mode.
ANTHROPIC_API_KEY=

# Email via SMTP. For Gmail: SMTP_USER = your Gmail address and SMTP_PASSWORD =
# an App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# EMAIL_FROM=   # defaults to SMTP_USER
