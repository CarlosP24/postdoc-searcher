# Optional, for local runs only (never commit .env). The daily runs happen on
# GitHub Actions, which needs just one secret: CLAUDE_CODE_OAUTH_TOKEN.

# Only for llm.backend: api — a Claude API key (https://platform.claude.com/).
# The default backend (claude-code) uses your Claude subscription instead.
ANTHROPIC_API_KEY=

# Optional SMTP email. Not needed: on GitHub, notifications are issues that
# GitHub emails to you. Prefer a sending-only provider over a Gmail app password.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=
# EMAIL_FROM=   # defaults to SMTP_USER
